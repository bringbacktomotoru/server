# Runtime environment variables
# Copy to a local env file (gitignored) for local development.

# Required (>= 32 characters): HMAC-SHA256 secret for stateless session tokens
SESSION_SECRET=

# Wire protocol Blowfish key
BLOWFISH_KEY=test

# Server behavior
DEBUG_MODE=false
ALLOW_PLAINTEXT_REQUESTS=false
MAINTENANCE_MODE=0
DEBUG_FRIENDCODE=
PKG_VERSION=1027
SESSION_TTL_SEC=604800
TAKEOVER_TTL_SEC=86400
MAX_REQUEST_BODY_BYTES=524288
MAX_DECOMPRESSED_BYTES=2097152
ENABLE_REPORT_STORAGE=false
LOG_LEVEL=info
